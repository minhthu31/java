        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Khối Frontend\n    FE[\&quot;💻 Frontend\\n(Giao diện người dùng)\&quot;]\n\n    %% Khối Database &amp; External APIs\n    DB[(\&quot;🛢️ Database\\n(MySQL)\&quot;)]\n    Jira((\&quot;☁️ Jira Cloud REST API\&quot;))\n    GitHub((\&quot;☁️ GitHub REST API\&quot;))\n\n    %% Khối Backend - Spring Boot\n    subgraph Backend [\&quot;⚙️ Backend - Spring Boot\&quot;]\n        direction TB\n        Controller[\&quot;Controller\\n(REST API)\&quot;]\n        \n        subgraph ServiceLayer [\&quot;Service Layer\&quot;]\n            direction TB\n            TaskService[\&quot;Task Service\&quot;]\n            JiraService[\&quot;Jira Integration Service\&quot;]\n            GitService[\&quot;GitHub Integration Service\&quot;]\n            ReportService[\&quot;Report Service\&quot;]\n        end\n        \n        Repository[\&quot;Repository\\n(Truy xuất dữ liệu)\&quot;]\n        Entity[\&quot;Entity/Model\&quot;]\n    end\n\n    %% Giao tiếp giữa các thành phần\n    FE &lt;==&gt;|Gửi Request / Nhận Response| Controller\n    \n    Controller &lt;--&gt; ServiceLayer\n    \n    ServiceLayer &lt;--&gt; Repository\n    Repository -.-&gt;|Biểu diễn dữ liệu| Entity\n    Repository &lt;==&gt;|Đọc / Ghi dữ liệu| DB\n    \n    JiraService &lt;==&gt;|Gọi API / Đồng bộ| Jira\n    GitService &lt;==&gt;|Gọi API / Đồng bộ| GitHub\n\n    %% Tùy chỉnh màu sắc cho đẹp mắt\n    classDef frontend fill:#d5e8d4,stroke:#82b366,stroke-width:2px;\n    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px;\n    classDef service fill:#fff2cc,stroke:#d6b656,stroke-width:1px;\n    classDef database fill:#f8cecc,stroke:#b85450,stroke-width:2px;\n    classDef cloud fill:#e1d5e7,stroke:#9673a6,stroke-width:2px;\n\n    class FE frontend;\n    class Backend backend;\n    class TaskService,JiraService,GitService,ReportService service;\n    class DB database;\n    class Jira,GitHub cloud;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="p4W5lk3BxdlX5m_LhhBJ-27">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">

        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    ROLES {\n        int id PK\n        varchar name \&quot;NOT NULL, UNIQUE\&quot;\n    }\n    USERS {\n        int id PK\n        int role_id FK\n        varchar username \&quot;NOT NULL, UNIQUE\&quot;\n        varchar email \&quot;NOT NULL, UNIQUE\&quot;\n        varchar password_hash \&quot;NOT NULL\&quot;\n        datetime created_at\n    }\n    STUDENT_GROUPS {\n        int id PK\n        varchar name \&quot;NOT NULL\&quot;\n        datetime created_at\n    }\n    GROUP_MEMBERS {\n        int group_id PK, FK\n        int user_id PK, FK\n        datetime joined_at\n    }\n    PROJECTS {\n        int id PK\n        int group_id FK\n        varchar name \&quot;NOT NULL\&quot;\n        text description\n    }\n    REQUIREMENTS {\n        int id PK\n        int project_id FK\n        varchar title \&quot;NOT NULL\&quot;\n        text description\n    }\n    TASKS {\n        int id PK\n        int project_id FK\n        int requirement_id FK\n        varchar title \&quot;NOT NULL\&quot;\n        varchar status \&quot;NOT NULL\&quot;\n    }\n    JIRA_ISSUES {\n        int id PK\n        int task_id FK \&quot;UNIQUE\&quot;\n        varchar jira_issue_key \&quot;NOT NULL\&quot;\n        varchar url\n    }\n    GITHUB_REPOSITORIES {\n        int id PK\n        int project_id FK\n        varchar repo_url \&quot;NOT NULL\&quot;\n    }\n    GITHUB_COMMITS {\n        int id PK\n        int repository_id FK\n        varchar commit_hash \&quot;NOT NULL, UNIQUE\&quot;\n        text message\n    }\n    TASK_COMMIT_LINKS {\n        int task_id PK, FK\n        int commit_id PK, FK\n    }\n    SYNC_LOGS {\n        int id PK\n        int project_id FK\n        varchar sync_type \&quot;Jira/Github\&quot;\n        varchar status\n        datetime created_at\n    }\n    ACTIVITY_LOGS {\n        int id PK\n        int user_id FK\n        varchar action \&quot;NOT NULL\&quot;\n        datetime created_at\n    }\n\n    %% Relationships\n    ROLES ||--o{ USERS : \&quot;has\&quot;\n    STUDENT_GROUPS ||--o{ GROUP_MEMBERS : \&quot;contains\&quot;\n    USERS ||--o{ GROUP_MEMBERS : \&quot;belongs to\&quot;\n    STUDENT_GROUPS ||--o{ PROJECTS : \&quot;owns\&quot;\n    PROJECTS ||--o{ REQUIREMENTS : \&quot;has\&quot;\n    PROJECTS ||--o{ TASKS : \&quot;has\&quot;\n    REQUIREMENTS ||--o{ TASKS : \&quot;relates to\&quot;\n    TASKS ||--o| JIRA_ISSUES : \&quot;tracked by\&quot;\n    PROJECTS ||--o{ GITHUB_REPOSITORIES : \&quot;has\&quot;\n    GITHUB_REPOSITORIES ||--o{ GITHUB_COMMITS : \&quot;contains\&quot;\n    TASKS ||--o{ TASK_COMMIT_LINKS : \&quot;linked to\&quot;\n    GITHUB_COMMITS ||--o{ TASK_COMMIT_LINKS : \&quot;linked to\&quot;\n    PROJECTS ||--o{ SYNC_LOGS : \&quot;generates\&quot;\n    USERS ||--o{ ACTIVITY_LOGS : \&quot;performs\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vzHVwl637ylARssmfaU0-1">

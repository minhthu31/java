        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Khối Frontend\n    FE[\&quot;💻 Frontend\\n(Giao diện người dùng)\&quot;]\n\n    %% Khối Database &amp; External APIs\n    DB[(\&quot;🛢️ Database\\n(MySQL)\&quot;)]\n    Jira((\&quot;☁️ Jira Cloud REST API\&quot;))\n    GitHub((\&quot;☁️ GitHub REST API\&quot;))\n\n    %% Khối Backend - Spring Boot\n    subgraph Backend [\&quot;⚙️ Backend - Spring Boot\&quot;]\n        direction TB\n        \n        Security[\&quot;🛡️ Security (Spring Security)\\n(Xác thực Token, Phân quyền API)\&quot;]\n        \n        Controller[\&quot;Controller Layer\\n(Tiếp nhận REST API, Validate Input, Trả Response)\&quot;]\n        \n        subgraph ServiceLayer [\&quot;Service Layer (Xử lý Nghiệp vụ &amp; Giao dịch)\&quot;]\n            direction TB\n            TaskService[\&quot;Task Service\&quot;]\n            JiraService[\&quot;Jira Integration Service\&quot;]\n            GitService[\&quot;GitHub Integration Service\&quot;]\n            ReportService[\&quot;Report Service\&quot;]\n        end\n        \n        Repository[\&quot;Repository Layer (Spring Data JPA)\\n(Thực thi truy vấn, Quản lý CSDL)\&quot;]\n        Entity[\&quot;Entity / Model\\n(Ánh xạ bảng CSDL - ORM)\&quot;]\n    end\n\n    %% Giao tiếp giữa các thành phần\n    FE &lt;==&gt;|1. Gửi Request / Nhận Response| Security\n    Security &lt;==&gt;|2. Request hợp lệ| Controller\n    \n    Controller &lt;--&gt;|3. Gọi hàm xử lý| ServiceLayer\n    \n    ServiceLayer &lt;--&gt;|4. Yêu cầu Lấy/Lưu dữ liệu| Repository\n    Repository -.-&gt;|5. CRUD / Quản lý vòng đời| Entity\n    Repository &lt;==&gt;|6. Đọc / Ghi dữ liệu| DB\n    \n    JiraService &lt;==&gt;|Gọi API, Xử lý lỗi, Đồng bộ| Jira\n    GitService &lt;==&gt;|Gọi API, Xử lý lỗi, Đồng bộ| GitHub\n\n    %% Tùy chỉnh màu sắc\n    classDef frontend fill:#d5e8d4,stroke:#82b366,stroke-width:2px;\n    classDef backend fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px;\n    classDef service fill:#fff2cc,stroke:#d6b656,stroke-width:1px;\n    classDef database fill:#f8cecc,stroke:#b85450,stroke-width:2px;\n    classDef cloud fill:#e1d5e7,stroke:#9673a6,stroke-width:2px;\n    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray: 5 5;\n\n    class FE frontend;\n    class Backend backend;\n    class TaskService,JiraService,GitService,ReportService service;\n    class DB database;\n    class Jira,GitHub cloud;\n    class Security security;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yaEqjOMav6Wal5ycMUkh-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">

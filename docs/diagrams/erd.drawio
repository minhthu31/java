  <diagram id="F2wpaR-rNrG2cjkEwleg" name="Trang-11">
    <mxGraphModel dx="5933" dy="3300" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ==========================================\n    %% NHÓM 1: HỆ THỐNG &amp; NGƯỜI DÙNG\n    %% ==========================================\n    roles ||--o{ users : \&quot;has\&quot;\n    users ||--o{ user_external_accounts : \&quot;maps to\&quot;\n\n    roles {\n        int id PK\n        varchar name\n    }\n    users {\n        bigint id PK\n        int role_id FK\n        varchar username\n        varchar email\n        varchar password_hash\n        varchar status\n        datetime created_at\n    }\n    user_external_accounts {\n        bigint id PK\n        bigint user_id FK\n        varchar jira_account_id\n        varchar github_user_id\n    }\n\n    %% ==========================================\n    %% NHÓM 2: NHÓM &amp; DỰ ÁN\n    %% ==========================================\n    users ||--o{ student_groups : \&quot;leads\&quot;\n    student_groups ||--o{ group_members : \&quot;contains\&quot;\n    users ||--o{ group_members : \&quot;is member\&quot;\n    student_groups ||--o{ group_lecturers : \&quot;managed by\&quot;\n    users ||--o{ group_lecturers : \&quot;is lecturer\&quot;\n    student_groups ||--o{ projects : \&quot;has\&quot;\n\n    student_groups {\n        int id PK\n        varchar code\n        varchar name\n        bigint leader_user_id FK\n        date start_date\n        date end_date\n        varchar status\n    }\n    group_members {\n        int group_id PK,FK\n        bigint user_id PK,FK\n        varchar member_role\n        datetime joined_at\n    }\n    group_lecturers {\n        int group_id PK,FK\n        bigint lecturer_user_id PK,FK\n        datetime assigned_at\n    }\n    projects {\n        int id PK\n        int group_id FK\n        varchar name\n        varchar jira_project_id\n        varchar jira_project_key\n        varchar status\n    }\n\n    %% ==========================================\n    %% NHÓM 3: YÊU CẦU &amp; TASK &amp; JIRA\n    %% ==========================================\n    projects ||--o{ requirements : \&quot;has\&quot;\n    projects ||--o{ features : \&quot;has\&quot;\n    projects ||--o{ sprints : \&quot;has\&quot;\n    projects ||--o{ tasks : \&quot;has\&quot;\n    requirements ||--o{ tasks : \&quot;divided into\&quot;\n    features ||--o{ tasks : \&quot;groups\&quot;\n    sprints ||--o{ tasks : \&quot;contains\&quot;\n    users ||--o{ tasks : \&quot;assigned to\&quot;\n    tasks ||--|| jira_issues : \&quot;syncs to\&quot;\n\n    requirements {\n        int id PK\n        int project_id FK\n        varchar jira_issue_key\n        varchar title\n        varchar actor\n        varchar priority\n        varchar status\n    }\n    features {\n        int id PK\n        int project_id FK\n        varchar jira_epic_key\n        varchar name\n        int parent_feature_id FK\n    }\n    sprints {\n        int id PK\n        int project_id FK\n        varchar jira_sprint_id\n        varchar name\n        varchar state\n    }\n    tasks {\n        int id PK\n        int project_id FK\n        int requirement_id FK\n        int feature_id FK\n        int sprint_id FK\n        bigint assignee_user_id FK\n        varchar title\n        varchar issue_type\n        varchar priority\n        date deadline\n        varchar status\n        varchar sync_status\n    }\n    jira_issues {\n        int id PK\n        int task_id FK\n        varchar jira_issue_id\n        varchar jira_issue_key\n        datetime last_synced_at\n    }\n\n    %% ==========================================\n    %% NHÓM 4: GITHUB, AUTO-TEST &amp; LIÊN KẾT\n    %% ==========================================\n    projects ||--o{ github_repositories : \&quot;uses\&quot;\n    github_repositories ||--o{ github_commits : \&quot;contains\&quot;\n    github_repositories ||--o{ github_pull_requests : \&quot;contains\&quot;\n    github_commits ||--o{ workflow_runs : \&quot;triggers\&quot;\n    \n    tasks ||--o{ task_commit_links : \&quot;linked via\&quot;\n    github_commits ||--o{ task_commit_links : \&quot;linked via\&quot;\n    \n    tasks ||--o{ task_pr_links : \&quot;linked via\&quot;\n    github_pull_requests ||--o{ task_pr_links : \&quot;linked via\&quot;\n\n    github_repositories {\n        int id PK\n        int project_id FK\n        varchar full_name\n        varchar default_branch\n    }\n    github_commits {\n        int id PK\n        int repository_id FK\n        varchar sha\n        bigint author_external_id FK\n        varchar message\n        int additions\n        int deletions\n        boolean is_reverted\n    }\n    github_pull_requests {\n        int id PK\n        int repository_id FK\n        int number\n        varchar head_ref\n        varchar state\n        varchar html_url\n    }\n    workflow_runs {\n        int id PK\n        int repository_id FK\n        int commit_id FK\n        varchar external_run_id\n        varchar status\n        varchar conclusion\n    }\n    task_commit_links {\n        int task_id PK,FK\n        int commit_id PK,FK\n        varchar link_source\n        bigint linked_by FK\n    }\n    task_pr_links {\n        int task_id PK,FK\n        int pr_id PK,FK\n        varchar link_source\n    }\n\n    %% ==========================================\n    %% NHÓM 5: LOGGING &amp; XUẤT BÁO CÁO (SRS)\n    %% ==========================================\n    projects ||--o{ sync_logs : \&quot;generates\&quot;\n    student_groups ||--o{ activity_logs : \&quot;tracks\&quot;\n    projects ||--o{ srs_versions : \&quot;exports\&quot;\n\n    sync_logs {\n        int id PK\n        int project_id FK\n        varchar provider\n        varchar entity_type\n        varchar status\n        varchar error_message\n    }\n    activity_logs {\n        int id PK\n        bigint actor_user_id FK\n        int group_id FK\n        varchar action\n        varchar result\n        datetime created_at\n    }\n    srs_versions {\n        int id PK\n        int project_id FK\n        varchar version\n        varchar file_path\n        datetime generated_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9SLft853uTxEdCbfqF1--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

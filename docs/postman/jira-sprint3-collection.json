{
	"info": {
		"name": "CNPM Sprint 3 - Jira Integration",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Config & Test Connection",
			"item": [
				{
					"name": "Cập nhật cấu hình Jira",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response có cấu trúc data và timestamp\", function () {",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData).to.have.property('timestamp');",
									"});",
									"pm.test(\"Response không lộ API Token (che secret)\", function () {",
									"    if (jsonData.data && jsonData.data.apiToken) {",
									"        pm.expect(jsonData.data.apiToken).to.not.equal(pm.environment.get(\"jira_api_token\"));",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_admin}}", "type": "string" } ] },
						"method": "PUT",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/integrations/jira/config", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "integrations", "jira", "config" ] },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"siteUrl\": \"{{jira_site_url}}\",\n  \"projectKey\": \"{{jira_project_key}}\",\n  \"email\": \"{{jira_email}}\",\n  \"apiToken\": \"{{jira_api_token}}\",\n  \"authType\": \"BASIC\"\n}"
						}
					}
				},
				{
					"name": "Đọc cấu hình Jira",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response có cấu trúc data và timestamp\", function () {",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData).to.have.property('timestamp');",
									"});",
									"pm.test(\"Response không lộ API Token khi GET (che secret)\", function () {",
									"    if (jsonData.data && jsonData.data.apiToken) {",
									"        pm.expect(jsonData.data.apiToken).to.not.equal(pm.environment.get(\"jira_api_token\"));",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_admin}}", "type": "string" } ] },
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/integrations/jira/config", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "integrations", "jira", "config" ] }
					}
				},
				{
					"name": "Test Connection",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response có cấu trúc data và timestamp\", function () {",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData).to.have.property('timestamp');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_admin}}", "type": "string" } ] },
						"method": "POST",
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/integrations/jira/test-connection", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "integrations", "jira", "test-connection" ] }
					}
				}
			]
		},
		{
			"name": "2. Task Creation & Jira Sync",
			"item": [
				{
					"name": "Tạo Task Local (Lưu taskId)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response có cấu trúc data và timestamp\", function () {",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData).to.have.property('timestamp');",
									"});",
									"if(jsonData.data && jsonData.data.id) {",
									"    pm.environment.set(\"taskId\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_leader}}", "type": "string" } ] },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "tasks" ] },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Task cần đồng bộ Jira (Sprint 3)\",\n  \"acceptanceCriteria\": \"Kiểm tra Jira\",\n  \"issueType\": \"TASK\",\n  \"priority\": \"HIGH\"\n}"
						}
					}
				},
				{
					"name": "Đồng bộ Task lên Jira",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response trả về data\", function () { pm.expect(jsonData).to.have.property('data'); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_leader}}", "type": "string" } ] },
						"method": "POST",
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/integrations/jira/tasks/{{taskId}}/sync", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "integrations", "jira", "tasks", "{{taskId}}", "sync" ] }
					}
				},
				{
					"name": "Cập nhật Status Task",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response trả về data\", function () { pm.expect(jsonData).to.have.property('data'); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_leader}}", "type": "string" } ] },
						"method": "PATCH",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks/{{taskId}}/status", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "tasks", "{{taskId}}", "status" ] },
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}" }
					}
				},
				{
					"name": "Cập nhật Assignee Task",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response trả về data\", function () { pm.expect(jsonData).to.have.property('data'); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_leader}}", "type": "string" } ] },
						"method": "PATCH",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks/{{taskId}}/assignee", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "tasks", "{{taskId}}", "assignee" ] },
						"body": { "mode": "raw", "raw": "{\n  \"assigneeUserId\": {{member_user_id}}\n}" }
					}
				},
				{
					"name": "Đọc lại Task (Kiểm tra jiraIssueKey & syncStatus)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Dữ liệu Task có chứa jiraIssueKey và syncStatus\", function () {",
									"    pm.expect(jsonData.data).to.have.property('jiraIssueKey');",
									"    pm.expect(jsonData.data.jiraIssueKey).to.not.be.null;",
									"    pm.expect(jsonData.data).to.have.property('syncStatus');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_leader}}", "type": "string" } ] },
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks/{{taskId}}", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "tasks", "{{taskId}}" ] }
					}
				}
			]
		},
		{
			"name": "3. Project Data Sync & Logs",
			"item": [
				{
					"name": "Đồng bộ Issue/Backlog từ Jira",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response có cấu trúc data và timestamp\", function () {",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData).to.have.property('timestamp');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_leader}}", "type": "string" } ] },
						"method": "POST",
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/integrations/jira/sync", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "integrations", "jira", "sync" ] }
					}
				},
				{
					"name": "Đọc danh sách SyncLog",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
									"var jsonData = pm.response.json();",
									"pm.test(\"Response có data là một danh sách (array)\", function () {",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_leader}}", "type": "string" } ] },
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/integrations/jira/sync-logs", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "integrations", "jira", "sync-logs" ] }
					}
				}
			]
		},
		{
			"name": "4. [Tùy chọn] Retry Sync Task",
			"description": "Chỉ thực thi khi cố tình giả lập trạng thái SYNC_FAILED cho một Task.",
			"item": [
				{
					"name": "Retry Sync Task (Tùy chọn)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token_leader}}", "type": "string" } ] },
						"method": "POST",
						"header": [
							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/integrations/jira/tasks/{{taskId}}/retry", "host": [ "{{baseUrl}}" ], "path": [ "api", "v1", "projects", "{{projectId}}", "integrations", "jira", "tasks", "{{taskId}}", "retry" ] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "" },
		{ "key": "projectId", "value": "" },
		{ "key": "token_admin", "value": "" },
		{ "key": "token_leader", "value": "" },
		{ "key": "member_user_id", "value": "" },
		{ "key": "jira_site_url", "value": "" },
		{ "key": "jira_project_key", "value": "" },
		{ "key": "jira_email", "value": "" },
		{ "key": "jira_api_token", "value": "" },
		{ "key": "taskId", "value": "" }
	]
}
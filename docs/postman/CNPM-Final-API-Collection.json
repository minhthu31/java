  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Login bằng tài khoản ADMIN. Điền login_admin_username/login_admin_password trong Postman Environment; access token được lưu vào token_admin.",
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{login_admin_username}}\",\n  \"password\": \"{{login_admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200',()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test('Has access token',()=>pm.expect(b.data.accessToken).to.be.a('string').and.not.empty);",
                  "pm.environment.set('token_admin', b.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Team Leader",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Login bằng tài khoản TEAM_LEADER. Access token được lưu vào token_leader.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{login_leader_username}}\",\n  \"password\": \"{{login_leader_password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200',()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test('Has access token',()=>pm.expect(b.data.accessToken).to.be.a('string').and.not.empty);",
                  "pm.environment.set('token_leader', b.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Team Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Login bằng tài khoản TEAM_MEMBER. Access token được lưu vào token_member.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{login_member_username}}\",\n  \"password\": \"{{login_member_password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200',()=>pm.response.to.have.status(200));",
                  "const b=pm.response.json();",
                  "pm.test('Has access token',()=>pm.expect(b.data.accessToken).to.be.a('string').and.not.empty);",
                  "pm.environment.set('token_member', b.data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
